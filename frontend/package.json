{
  "name": "bms-frontend",
  "version": "1.0.0",
  "description": "BMS Monitor for JBD BLE Battery Management System",
  "author": "RCL Labs",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "package": "electron-builder --win -c.extraMetadata.main=dist-electron/main.js"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "6.1.0",
    "@capacitor-mlkit/barcode-scanning": "6.1.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/camera": "6.0.2",
    "@capacitor/cli": "6.1.2",
    "framer-motion": "^12.40.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "build": {
    "appId": "com.rcl.power",
    "productName": "ASTRA",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
